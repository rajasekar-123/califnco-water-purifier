{
  "name": "califnco-seed",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "node --env-file-if-exists=.env seed.mjs",
    "dry": "node seed.mjs --dry-run",
    "images:fetch": "node fetch-images.mjs",
    "images:validate": "node validate-images.mjs",
    "images:upload": "node --env-file-if-exists=.env upload-images.mjs",
