# --- Client (exposed to browser; Firebase web config is public by design) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (Vercel project env vars; NEVER prefix with VITE_) ---
# Whole service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
# Set to the admin origin in production
ALLOWED_ORIGIN=*
# Optional notifications (silently skipped when blank)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
