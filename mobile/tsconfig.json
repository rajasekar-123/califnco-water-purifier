{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "customConditions": [
      "react-native"
    ],
    "moduleResolution": "bundler",
    "types": [
      "jest",
      "node"
    ]
  },
  "exclude": [
    "node_modules"
  ]
}