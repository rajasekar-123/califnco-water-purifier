# Used by seed.mjs and upload-images.mjs (never commit the real values).
# Whole service-account JSON on ONE line (Firebase console -> Project settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to the line above: path to the downloaded JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudinary (Dashboard -> top-left cloud name; Settings -> Upload -> Upload presets -> Add -> Signing mode: Unsigned)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Wikimedia asks API clients to identify themselves; put your email or GitHub URL.
COMMONS_CONTACT=
