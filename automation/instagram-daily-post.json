        "jsCode": "const e = $json.execution || {};\nconst today = new Date(Date.now() + 5.5 * 3600e3).toISOString().slice(0, 10);\nreturn [{ json: { today, failedNode: e.lastNodeExecuted || 'unknown', message: String((e.error && e.error.message) || 'unknown error').slice(0, 900) } }];"
      }
    },
